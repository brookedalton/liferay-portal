				"file-format": {
					"term_map": {
						"field": "extension",
						"filter_mode": "pre",
						"frequency_threshold": "1",
						"label": "file-format",
						"multi_value": true,
						"multi_value_operator": "and",
						"name": "file-format",
						"parameter_name": "extension",
						"parameters": {
							"map": [
								{
									"key": "image",
									"values": [
										"png",
										"gif",
										"jpeg",
										"jpg",
										"tiff"
									]
								}
							]
						},
						"size": 50
					}
				},
				"folder": {
					"folder": {
						"field": "folderId",
						"label": "folder",
						"parameter_name": "folder"
					}
				},
				"modified": {
					"date_range": {
						"aggregation_name": "blueprints-modified",
						"field": "modified",
						"multi_value": false,
						"parameter_name": "modified",
