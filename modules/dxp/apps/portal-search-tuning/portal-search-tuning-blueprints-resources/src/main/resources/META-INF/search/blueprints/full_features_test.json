						"field": "scopeGroupId",
						"label": "site",
						"parameter_name": "site"
					}
				},
				"tag": {
					"terms": {
						"field": "assetTagNames.raw",
						"label": "tag",
						"parameter_name": "tag"
					}
				},
				"type": {
